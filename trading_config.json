{
  "server": {
    "http_host": "0.0.0.0",
    "http_port": 5000,
    "websocket_host": "0.0.0.0",
    "websocket_port": 8765,
    "enable_debug": false,
    "enable_reloader": false
  },
  "timing": {
    "idle_wait_seconds": 30,
    "websocket_restart_delay_seconds": 2,
    "browser_open_delay_seconds": 1.5,
    "github_api_timeout_seconds": 5,
    "provider_api_timeout_seconds": 10,
    "retry_delay_seconds": 1
  },
  "limits": {
    "account_value_history_limit": 100,
    "chart_data_limit": 100,
    "trades_limit_default": 50,
    "leaderboard_update_interval_seconds": 30
  },
  "risk": {
    "max_daily_loss": 0.05,
    "max_position_size": 0.8,
    "max_leverage": 5,
    "min_trade_size_usd": 10,
    "consecutive_loss_limit": 3,
    "allowed_leverages": [2, 3, 5],
    "max_position_coins": 3,
    "max_total_position_ratio": 0.85,
    "monitored_coins": [ "BTC","ETH", "SOL", "BNB", "DOGE", "XRP"],
    "take_profit_threshold": 0.15,
    "stop_loss_threshold": 0.10
  },
  "trading": {
    "fee_rate": 0.001,
    "retry_attempts": 3,
    "order_timeout_seconds": 30,
    "slippage_tolerance": 0.001,
    "max_orders_per_second": 5,
    "enable_paper_trading": true,
    "api_timeout_seconds": 15,
    "live_api_timeout_seconds": 30
  },
  "performance": {
    "target_sharpe_ratio": 1.5,
    "max_drawdown": 0.15,
    "enable_circuit_breaker": true,
    "performance_window_days": 30,
    "min_trades_for_analysis": 10,
    "websocket_market_update_interval": 1.0,
    "websocket_portfolio_update_interval": 2.0
  },
  "cache": {
    "price_cache_ttl": 1,
    "indicators_cache_ttl": 600,
    "max_cache_size": 1000
  },
  "multi_timeframe": {
    "timeframes": ["5m", "15m", "1H", "4H"],
    "timeframe_weights": {
      "4H": 40,
      "1H": 35,
      "15m": 20,
      "5m": 5
    },
    "timeframe_roles": {
      "4H": "大趋势判断",
      "1H": "主趋势判断",
      "15m": "入场时机",
      "5m": "精确入场"
    },
    "min_candles_required": 30,
    "max_candles_per_symbol": 500
  },
  "logging": {
    "level": "INFO",
    "enable_file_logging": true,
    "max_log_file_size_mb": 50,
    "backup_log_count": 5,
    "enable_performance_logging": true,
    "third_party_log_levels": {
      "httpx": "WARNING",
      "httpcore": "WARNING",
      "websockets": "WARNING",
      "urllib3": "WARNING",
      "werkzeug": "WARNING"
    }
  },
  "prompts": {
    "system_role": "你是专业的加密货币技术分析师。专注于技术分析，输出信号和置信度。",
    "decision_system_title": "技术分析系统",
    "trading_principles": [
      "基于技术指标识别趋势方向",
      "客观分析上涨和下跌机会",
      "只输出高置信度的技术信号"
    ],
    "important_reminders": [
      "输出格式：{\"币种\": [\"信号\", 置信度, \"依据\"]}",
      "buy信号表示看涨，sell信号表示看跌"
    ],
    "short_strategy_signals": [
      "价格跌破关键支撑位",
      "RSI>70且出现顶背离",
      "MACD在零轴下方死叉",
      "多时间框架空头排列(SMA7<SMA14<SMA30)",
      "下跌时成交量放大"
    ],
    "output_requirements": [
      "只输出JSON格式",
      "格式：{\"BTC\": [\"buy/sell/hold\", 0.85, \"技术分析依据\"]}"
    ],
    "min_confidence_threshold": 0.60,
    "high_confidence_threshold": 0.75,
    "extreme_confidence_threshold": 0.85,
    "leverage_mapping": {
      "extreme": 5,
      "high": 3,
      "medium": 2,
      "low": 1
    }
  }
}